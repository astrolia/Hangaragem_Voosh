<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.sahthan.sahthan_v1.controller.localidade.CadastrarLocalidadeController"
           style="-fx-background-color: #F3F4F6;"
           prefHeight="500.0"
           prefWidth="700.0">

    <VBox alignment="TOP_CENTER"
          spacing="20.0"
          maxWidth="550.0"
          maxHeight="420.0"
          style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-padding: 30;">

        <Label text="Cadastro de Localidade"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1F2937;" />

        <Region prefHeight="10" />

        <GridPane vgap="12.0" hgap="15.0" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="140.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Nome do Aeroporto:" style="-fx-text-fill: #4B5563; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label text="Cidade:" style="-fx-text-fill: #4B5563; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label text="UF:" style="-fx-text-fill: #4B5563; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label text="Número de Pistas:" style="-fx-text-fill: #4B5563; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3" />

                <TextField fx:id="txtNomeAeroporto" promptText="Ex: Viracopos - VCP" maxWidth="Infinity" style="-fx-pref-height: 32;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <TextField fx:id="txtCidade" promptText="Ex: Campinas" maxWidth="Infinity" style="-fx-pref-height: 32;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <TextField fx:id="txtUF" promptText="Ex: SP" maxWidth="Infinity" style="-fx-pref-height: 32;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <TextField fx:id="txtnPistas" promptText="Ex: 2" maxWidth="Infinity" style="-fx-pref-height: 32;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </children>
        </GridPane>

        <Region prefHeight="10" />

        <HBox spacing="15.0" alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="menu"
                        mnemonicParsing="false"
                        onAction="#voltarMenu"
                        style="-fx-background-color: #F3F4F6; -fx-text-fill: #4B5563; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-width: 100; -fx-pref-height: 35; -fx-font-weight: bold;"
                        text="Menu" />

                <Button fx:id="salvar"
                        mnemonicParsing="false"
                        onAction="#onSalvar"
                        style="-fx-background-color: #4F46E5; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-width: 120; -fx-pref-height: 35; -fx-font-weight: bold;"
                        text="Salvar" />
            </children>
        </HBox>
    </VBox>
</StackPane>