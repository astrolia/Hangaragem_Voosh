<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.sahthan.sahthan_v1.controller.hangar.VisualizarHangarController">
   <children>
      <TableView fx:id="tableViewHangar" maxWidth="1.7976931348623157E308" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: C2E1FF;">
        <columns>
            <TableColumn fx:id="columnNomeHangar" prefWidth="75.0" style="-fx-base: #82C1FF;" text="Nome" />
          <TableColumn fx:id="columnAltura" prefWidth="75.0" style="-fx-base: #82C1FF;" text="Altura" />
            <TableColumn fx:id="columnLargura" prefWidth="75.0" style="-fx-base: #82C1FF;" text="Largura" />
            <TableColumn fx:id="columnComprimento" prefWidth="75.0" style="-fx-base: #82C1FF;" text="Comprimento" />
            <TableColumn fx:id="columnStatusHangar" prefWidth="100.0" style="-fx-base: #82C1FF;" text="Status" />
            <TableColumn fx:id="columnLocalidade" prefWidth="75.0" style="-fx-base: #82C1FF;" text="Localidade" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button fx:id="remover" mnemonicParsing="false" onAction="#removerHangar" style="-fx-base: FF8282;" text="Remover" />
      <Button fx:id="menu" mnemonicParsing="false" onAction="#voltarMenu" style="-fx-base: #969EFF;" text="Menu" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
