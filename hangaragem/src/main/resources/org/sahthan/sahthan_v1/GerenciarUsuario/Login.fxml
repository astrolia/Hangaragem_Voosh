<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.sahthan.sahthan_v1.controller.usuario.LoginController"
           style="-fx-background-color: #f4f4f4;"> <VBox alignment="CENTER"
                                                         spacing="15"
                                                         maxWidth="350"
                                                         maxHeight="450"
                                                         style="-fx-padding: 30; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">

    <ImageView fitHeight="120"
               preserveRatio="true">
        <image>
            <Image url="@imagens/logo.png"/>
        </image>
    </ImageView>

    <Label text="Sistema de Gerenciamento de Hangares"
           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;"
           wrapText="true"
           alignment="CENTER"/>

    <Region prefHeight="10"/>

    <TextField fx:id="txtEmail"
               promptText="Email"
               maxWidth="Infinity"
               prefHeight="35"/>

    <PasswordField fx:id="txtSenha"
                   promptText="Senha"
                   maxWidth="Infinity"
                   prefHeight="35"/>

    <Button text="Entrar"
            maxWidth="Infinity"
            prefHeight="35"
            style="-fx-cursor: hand;"
            onAction="#onEntrar"/>

    <Hyperlink text="Criar uma conta"
               onAction="#irParaCadastro"
               style="-fx-underline: false;"/>

</VBox>

</StackPane>