<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.sahthan.sahthan_v1.controller.usuario.CadastroUsuarioController"
           style="-fx-background-color: #f4f4f4;"> <VBox alignment="CENTER"
                                                         spacing="15"
                                                         maxWidth="350"
                                                         maxHeight="550"
                                                         style="-fx-padding: 30; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">

    <Label text="Criar Conta"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

    <Region prefHeight="10"/>

    <TextField fx:id="txtNome"
               promptText="Nome"
               maxWidth="Infinity"
               prefHeight="35"/>

    <TextField fx:id="txtEmail"
               promptText="Email"
               maxWidth="Infinity"
               prefHeight="35"/>

    <PasswordField fx:id="txtSenha"
                   promptText="Senha"
                   maxWidth="Infinity"
                   prefHeight="35"/>

    <PasswordField fx:id="txtConfirmarSenha"
                   promptText="Confirmar senha"
                   maxWidth="Infinity"
                   prefHeight="35"/>

    <Region prefHeight="10"/>

    <Button text="Salvar"
            maxWidth="Infinity"
            prefHeight="35"
            style="-fx-cursor: hand;"
            onAction="#onSalvar"/>

    <Hyperlink text="Voltar para o Login"
               onAction="#voltarLogin"
               style="-fx-underline: false;"/>

</VBox>

</StackPane>