<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER"
      maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.sahthan.sahthan_v1.controller.MenuController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <children>

        <VBox alignment="TOP_CENTER"
              spacing="50.0"
              style="-fx-background-color: #969EFF;"
              HBox.hgrow="ALWAYS">

            <children>

                <Label alignment="TOP_LEFT" text="Aeronaves">
                    <graphic>
                        <ImageView fitHeight="31.0"
                                   fitWidth="32.0"
                                   pickOnBounds="true"
                                   preserveRatio="true">
                            <image>
                                <Image url="@imagens/IconAviao.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>

                <Button fx:id="irCadastro"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        onAction="#irParaCadastrarAeronave"
                        style="-fx-base: #969EFF;"
                        text="Cadastrar"/>

                <Button fx:id="irVisualizar"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        onAction="#irParaVisualizarAeronave"
                        style="-fx-base: #969EFF;"
                        text="Visualizar"/>

            </children>

            <padding>
                <Insets top="20.0"/>
            </padding>

        </VBox>

        <VBox alignment="TOP_CENTER"
              layoutX="30.0"
              layoutY="30.0"
              spacing="50.0"
              style="-fx-background-color: #91F2D8;"
              HBox.hgrow="ALWAYS">

            <children>

                <Label alignment="TOP_LEFT" text="Locação">
                    <graphic>
                        <ImageView fitHeight="31.0"
                                   fitWidth="32.0"
                                   pickOnBounds="true"
                                   preserveRatio="true">
                            <image>
                                <Image url="@imagens/maos.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>

                <Button fx:id="irCadastro1"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        onAction="#irParaCadastrarLocacao"
                        style="-fx-base: #91F2D8;"
                        text="Nova Locação"/>

                <Button fx:id="irVisualizar1"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        onAction="#irParaVisualizarLocacao"
                        style="-fx-base: #91F2D8;"
                        text="Gerenciar"/>

            </children>

            <padding>
                <Insets top="20.0"/>
            </padding>

        </VBox>

        <VBox alignment="TOP_CENTER"
              layoutX="30.0"
              layoutY="30.0"
              spacing="50.0"
              style="-fx-background-color: #94F7A2;"
              HBox.hgrow="ALWAYS">

            <children>

                <Label alignment="TOP_LEFT" text="Hangares">
                    <graphic>
                        <ImageView fitHeight="31.0"
                                   fitWidth="32.0"
                                   pickOnBounds="true"
                                   preserveRatio="true">
                            <image>
                                <Image url="@imagens/hangar.jpg"/>
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>

                <Button fx:id="irCadastro2"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        onAction="#irParaCadastrarLocalidade"
                        style="-fx-base: #94F7A2;"
                        text="Cadastrar Localidade"/>

                <Button fx:id="irCadastro3"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        onAction="#irParaCadastrarHangar"
                        style="-fx-base: #94F7A2;"
                        text="Cadastrar Hangar"/>

                <Button fx:id="visualizarLocalidade"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        onAction="#irParaVisualizarLocalidade"
                        style="-fx-base: #94F7A2;"
                        text="Visualizar Localidade"/>

                <Button fx:id="visualizarHangar"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        onAction="#irParaVisualizarHangar"
                        style="-fx-base: #94F7A2;"
                        text="Visualizar Hangar"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Sair"
                        mnemonicParsing="false"
                        onAction="#logout"
                        prefWidth="120.0"/>

            </children>

            <padding>
                <Insets top="20.0"/>
            </padding>

        </VBox>

    </children>

</HBox>