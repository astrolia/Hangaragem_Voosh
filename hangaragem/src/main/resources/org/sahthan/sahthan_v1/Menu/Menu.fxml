<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.sahthan.sahthan_v1.controller.MenuController"
      style="-fx-background-color: #F3F4F6;"
      prefHeight="500.0"
      prefWidth="850.0">

    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">

        <padding>
            <Insets bottom="15.0" left="25.0" right="25.0" top="15.0"/>
        </padding>

        <children>
            <Label text="Sistema de Gerenciamento" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Sair do Sistema"
                    mnemonicParsing="false"
                    onAction="#logout"
                    style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;"/>
        </children>
    </HBox>

    <HBox alignment="CENTER"
          spacing="25.0"
          VBox.vgrow="ALWAYS">

        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
        </padding>

        <VBox alignment="TOP_CENTER"
              spacing="15.0"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-padding: 25;"
              HBox.hgrow="ALWAYS">

            <Label text="Aeronaves" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F2937;">
                <graphic>
                    <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                        <image>
                            <Image url="@imagens/IconAviao.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Label>

            <Region prefHeight="15"/>

            <Button fx:id="irCadastro"
                    maxWidth="Infinity"
                    mnemonicParsing="false"
                    onAction="#irParaCadastrarAeronave"
                    style="-fx-background-color: #4F46E5; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-height: 38;"
                    text="Cadastrar Aeronave"/>

            <Button fx:id="irVisualizar"
                    maxWidth="Infinity"
                    mnemonicParsing="false"
                    onAction="#irParaVisualizarAeronave"
                    style="-fx-background-color: #F3F4F6; -fx-text-fill: #1F2937; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-height: 38;"
                    text="Visualizar Frota"/>

        </VBox>

        <VBox alignment="TOP_CENTER"
              spacing="15.0"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-padding: 25;"
              HBox.hgrow="ALWAYS">

            <Label text="Locação" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F2937;">
                <graphic>
                    <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                        <image>
                            <Image url="@imagens/maos.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Label>

            <Region prefHeight="15"/>

            <Button fx:id="irCadastro1"
                    maxWidth="Infinity"
                    mnemonicParsing="false"
                    onAction="#irParaCadastrarLocacao"
                    style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-height: 38;"
                    text="Nova Locação"/>

            <Button fx:id="irVisualizar1"
                    maxWidth="Infinity"
                    mnemonicParsing="false"
                    onAction="#irParaVisualizarLocacao"
                    style="-fx-background-color: #F3F4F6; -fx-text-fill: #1F2937; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-height: 38;"
                    text="Gerenciar Contratos"/>

        </VBox>

        <VBox alignment="TOP_CENTER"
              spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-padding: 25;"
              HBox.hgrow="ALWAYS">

            <Label text="Hangares" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F2937;">
                <graphic>
                    <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                        <image>
                            <Image url="@imagens/hangar.jpg"/>
                        </image>
                    </ImageView>
                </graphic>
            </Label>

            <Region prefHeight="15"/>

            <Button fx:id="irCadastro2"
                    maxWidth="Infinity"
                    mnemonicParsing="false"
                    onAction="#irParaCadastrarLocalidade"
                    style="-fx-background-color: #4F46E5; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-height: 35;"
                    text="Cadastrar Localidade"/>

            <Button fx:id="visualizarLocalidade"
                    maxWidth="Infinity"
                    mnemonicParsing="false"
                    onAction="#irParaVisualizarLocalidade"
                    style="-fx-background-color: #F3F4F6; -fx-text-fill: #1F2937; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-height: 35;"
                    text="Visualizar Localidades"/>

            <Button fx:id="irCadastro3"
                    maxWidth="Infinity"
                    mnemonicParsing="false"
                    onAction="#irParaCadastrarHangar"
                    style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-height: 35;"
                    text="Cadastrar Hangar"/>

            <Button fx:id="visualizarHangar"
                    maxWidth="Infinity"
                    mnemonicParsing="false"
                    onAction="#irParaVisualizarHangar"
                    style="-fx-background-color: #F3F4F6; -fx-text-fill: #1F2937; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-height: 35;"
                    text="Visualizar Hangares"/>

        </VBox>

    </HBox>

</VBox>