<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.sahthan.sahthan_v1.controller.locacao.CadastrarLocacaoController"
           style="-fx-background-color: #F3F4F6;"
           prefHeight="400.0"
           prefWidth="850.0"> <VBox alignment="TOP_CENTER"
                                    spacing="20.0"
                                    maxWidth="800.0"
                                    maxHeight="280.0"
                                    style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4); -fx-padding: 30;">

    <Label text="Nova Locação"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1F2937;" />

    <Region prefHeight="10" />

    <GridPane vgap="8.0" hgap="12.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="25.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
        </rowConstraints>
        <children>
            <Label text="Localidade" style="-fx-text-fill: #4B5563; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label text="Hangar" style="-fx-text-fill: #4B5563; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Aeronave" style="-fx-text-fill: #4B5563; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <Label text="Check-in" style="-fx-text-fill: #4B5563; -fx-font-weight: bold;" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            <Label text="Check-out" style="-fx-text-fill: #4B5563; -fx-font-weight: bold;" GridPane.columnIndex="4" GridPane.rowIndex="0" />
            <Label text="Valor (R$)" style="-fx-text-fill: #4B5563; -fx-font-weight: bold;" GridPane.columnIndex="5" GridPane.rowIndex="0" />

            <ComboBox fx:id="comboLocalidade" promptText="Selecione..." maxWidth="Infinity" style="-fx-pref-height: 32;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="comboHangar" promptText="Selecione..." maxWidth="Infinity" style="-fx-pref-height: 32;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <ComboBox fx:id="comboAeronave" promptText="Selecione..." maxWidth="Infinity" style="-fx-pref-height: 32;" GridPane.columnIndex="2" GridPane.rowIndex="1" />

            <TextField fx:id="txtCheckin" promptText="DD/MM/AAAA" maxWidth="Infinity" style="-fx-pref-height: 32;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <TextField fx:id="txtCheckout" promptText="DD/MM/AAAA" maxWidth="Infinity" style="-fx-pref-height: 32;" GridPane.columnIndex="4" GridPane.rowIndex="1" />
            <TextField fx:id="txtValor" promptText="0.00" maxWidth="Infinity" style="-fx-pref-height: 32;" GridPane.columnIndex="5" GridPane.rowIndex="1" />
        </children>
    </GridPane>

    <Region prefHeight="15" />

    <HBox spacing="15.0" alignment="CENTER_RIGHT">
        <children>
            <Button fx:id="menu"
                    mnemonicParsing="false"
                    onAction="#voltarMenu"
                    style="-fx-background-color: #F3F4F6; -fx-text-fill: #4B5563; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-width: 100; -fx-pref-height: 35; -fx-font-weight: bold;"
                    text="Menu" />

            <Button fx:id="registrar"
                    mnemonicParsing="false"
                    onAction="#onSalvar"
                    style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6; -fx-pref-width: 120; -fx-pref-height: 35; -fx-font-weight: bold;"
                    text="Registrar" />
        </children>
    </HBox>
</VBox>
</StackPane>